OpCapability Shader
OpMemoryModel Logical GLSL450
OpEntryPoint Vertex %main "main" %vertex %position
OpDecorate %vertex BuiltIn VertexIndex
OpDecorate %position BuiltIn Position
%void = OpTypeVoid
%fn = OpTypeFunction %void
%int = OpTypeInt 32 1
%uint = OpTypeInt 32 0
%float = OpTypeFloat 32
%v2 = OpTypeVector %float 2
%v4 = OpTypeVector %float 4
%three = OpConstant %uint 3
%arr = OpTypeArray %v2 %three
%minus = OpConstant %float -1
%plus = OpConstant %float 3
%zero = OpConstant %float 0
%one = OpConstant %float 1
%p0 = OpConstantComposite %v2 %minus %minus
%p1 = OpConstantComposite %v2 %plus %minus
%p2 = OpConstantComposite %v2 %minus %plus
%points = OpConstantComposite %arr %p0 %p1 %p2
%pArray = OpTypePointer Private %arr
%pPoint = OpTypePointer Private %v2
%positions = OpVariable %pArray Private %points
%pIndex = OpTypePointer Input %int
%vertex = OpVariable %pIndex Input
%pPosition = OpTypePointer Output %v4
%position = OpVariable %pPosition Output
%main = OpFunction %void None %fn
%entry = OpLabel
%index = OpLoad %int %vertex
%at = OpAccessChain %pPoint %positions %index
%point = OpLoad %v2 %at
%x = OpCompositeExtract %float %point 0
%y = OpCompositeExtract %float %point 1
%value = OpCompositeConstruct %v4 %x %y %zero %one
OpStore %position %value
OpReturn
OpFunctionEnd
